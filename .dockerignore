# Secrets — never bake into an image
.env
*.env
!.env.example

# Local virtualenv (the image builds its own via uv)
.venv/

# VCS / CI
.git/
.gitignore

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Generated data dumps & session scratch
data/*.json
data/*.ndjson
.remember/
