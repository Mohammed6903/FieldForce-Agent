# ─── Elastic Cloud ────────────────────────────────────────────────────────────
# From your Elastic Cloud deployment ("Copy endpoint" + create an API key)
ELASTIC_ENDPOINT=https://my-deployment.es.us-central1.gcp.cloud.es.io:443
ELASTIC_API_KEY=replace_with_base64_api_key
# Inference endpoint id used by the semantic_text field (ELSER). Default works on
# recent Elastic Cloud deployments where ELSER is auto-deployed.
SEMANTIC_INFERENCE_ID=.elser-2-elasticsearch

# ─── Gemini (via Vertex AI / Google Cloud Agent Builder) ──────────────────────
# Recommended: Vertex AI (uses your GCP project + $300 credits)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.1-pro-preview
# Alternative: Google AI Studio key (set USE_VERTEXAI=FALSE and uncomment)
# GOOGLE_API_KEY=your_ai_studio_key

# ─── Demo geography (city the synthetic fleet operates in) ────────────────────
DISPATCH_CITY=San Francisco
DISPATCH_CITY_LAT=37.7749
DISPATCH_CITY_LON=-122.4194

# ─── App ──────────────────────────────────────────────────────────────────────
APP_PORT=8080
